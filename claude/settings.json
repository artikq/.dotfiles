{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 1
  },
  "tui": "default",
  "editorMode": "vim",
  "preferredNotifChannel": "auto",
  "promptSuggestionEnabled": false,
  "teammateMode": "auto",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && printf '\\a' > \"$(tmux display -p -t \"$TMUX_PANE\" '#{pane_tty}')\"; exit 0"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "msg=$(jq -r \".message // \\\"Claude needs your attention\\\"\"); [ -n \"$TMUX_PANE\" ] && tty=$(tmux display -p -t \"$TMUX_PANE\" '#{pane_tty}') && printf '\\ePtmux;\\e\\e]777;notify;Claude Code;%s\\a\\e\\\\' \"$msg\" > \"$tty\" && printf '\\a' > \"$tty\"; exit 0"
          }
        ]
      }
    ]
  }
}
